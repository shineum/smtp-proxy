# =============================================================================
# smtp-proxy - Environment Variables
#
# Copy this file to .env and adjust values for your local environment.
#   cp .env.example .env
# =============================================================================

# Database (used by PostgreSQL container)
POSTGRES_USER=smtp_proxy
POSTGRES_PASSWORD=smtp_proxy_dev
POSTGRES_DB=smtp_proxy

# Application Database Config (used by Go services)
SMTP_PROXY_DATABASE_HOST=postgres
SMTP_PROXY_DATABASE_PORT=5432
SMTP_PROXY_DATABASE_USER=smtp_proxy
SMTP_PROXY_DATABASE_PASSWORD=smtp_proxy_dev
SMTP_PROXY_DATABASE_NAME=smtp_proxy
SMTP_PROXY_DATABASE_SSLMODE=disable

# Queue backend: "redis" (default) or "sqs"
SMTP_PROXY_QUEUE_TYPE=redis

# Redis (used when SMTP_PROXY_QUEUE_TYPE=redis)
SMTP_PROXY_QUEUE_REDIS_ADDR=redis:6379

# SQS (used when SMTP_PROXY_QUEUE_TYPE=sqs)
# SMTP_PROXY_QUEUE_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/smtp-proxy
# SMTP_PROXY_QUEUE_SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789/smtp-proxy-dlq
# SMTP_PROXY_QUEUE_SQS_REGION=us-east-1

# Delivery Mode: sync (no queue needed) or async (requires redis or sqs)
SMTP_PROXY_DELIVERY_MODE=sync

# TLS Certificates (container paths; mounted from ./certs/)
SMTP_PROXY_TLS_CERT_FILE=/certs/server.crt
SMTP_PROXY_TLS_KEY_FILE=/certs/server.key

# JWT Auth
SMTP_PROXY_AUTH_SIGNING_KEY=dev-signing-key-change-in-production

# Message Storage: "local" (default) or "s3"
SMTP_PROXY_STORAGE_TYPE=local
SMTP_PROXY_STORAGE_PATH=/data/messages
# SMTP_PROXY_STORAGE_S3_BUCKET=my-smtp-proxy-messages
# SMTP_PROXY_STORAGE_S3_PREFIX=messages/
# SMTP_PROXY_STORAGE_S3_ENDPOINT=           # custom endpoint for MinIO
# SMTP_PROXY_STORAGE_S3_REGION=us-east-1

# AWS Credentials (for S3 storage or SQS queue; not needed when using IAM roles)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Logging
SMTP_PROXY_LOGGING_LEVEL=debug
